# Supabase Configuration
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required in production. Render Blueprint generates this automatically.
SESSION_SECRET=
# Optional canonical URL for OAuth and email confirmation.
# PUBLIC_ORIGIN=https://watermi.onrender.com

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Deep Analysis: vision + structured JSON
ANALYSIS_MODEL=gemini-3.8-flash
# Used for analysis only while the models before them are busy or at their limit, in this order (comma-separated).
# Leave empty to turn off.
ANALYSIS_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional last backup for analysis, used only when every Gemini model above is busy or at its limit.
# Get a key at https://console.groq.com/keys. Leave empty to turn off.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# Chat: lighter model, streamed
CHAT_MODEL=gemini-3.5-flash-lite
# Used for chat only when the model above is busy or at its limit (comma-separated). Empty turns it off.
CHAT_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional second opinion on the plant and its diseases, from https://my.plantnet.org
# Each analysis uses 2 of the 500 free requests per day. Leave empty to turn off.
PLANTNET_API_KEY=

PORT=3000
# Only this computer can connect. Set to 0.0.0.0 to open the app from your phone on the
# same Wi-Fi.
HOST=127.0.0.1

# Optional ESP32 live sensor settings
# Mark sensors "Not connected" if no reading arrives within this many ms (0 disables timeout).
# SENSOR_TIMEOUT_MS=30000
# Optional secret required in the x-sensor-key header for POST /api/plants/:id/sensors.
# SENSOR_KEY=

# Optional Blynk Cloud auto-sync (pulls V0=Humidity, V1=Temp, V2=Soil, V3=Light automatically)
# BLYNK_TEMPLATE_ID=
# BLYNK_AUTH_TOKEN=
# BLYNK_SERVER=https://blynk.cloud
# BLYNK_PLANT_ID=
